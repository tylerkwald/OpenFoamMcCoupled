FoamFile
{
    version     2.0;
    format      ascii;
    arch        "LSB;label=32;scalar=64";
    class       polyBoundaryMesh;
    location    "constant/claddingZone/polyMesh";
    object      boundary;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //


4
(
    inlet
    {
        type            patch;
        nFaces          220;
        startFace       89572;
    }

    outlet
    {
        type            patch;
        nFaces          220;
        startFace       89792;
    }

    claddingZone_to_fuelZone
    {
        type            mappedWall;
        inGroups        1 ( wall );
        nFaces          30912;
        startFace       90012;
        sampleMode      nearestPatchFace;
        sampleRegion    fuelZone;
        samplePatch     fuelZone_to_claddingZone;
    }

    claddingZone_to_coolantZone
    {
        type            mappedWall;
        inGroups        1 ( wall );
        nFaces          32384;
        startFace       120924;
        sampleMode      nearestPatchFace;
        sampleRegion    coolantZone;
        samplePatch     coolantZone_to_claddingZone;
    }

)


