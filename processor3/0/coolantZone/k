FoamFile
{
    version     2.0;
    format      ascii;
    arch        "LSB;label=32;scalar=64";
    class       volScalarField;
    location    "0/coolantZone";
    object      k;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 2 -2 0 0 0 0];

internalField   uniform 0.06;

boundaryField
{
    inlet
    {
        type            fixedValue;
        value           nonuniform List<scalar> 0();
    }
    outlet
    {
        type            inletOutlet;
        inletValue      nonuniform List<scalar> 0();
        value           nonuniform List<scalar> 0();
    }
    min_x
    {
        type            symmetryPlane;
    }
    max_x
    {
        type            symmetryPlane;
    }
    min_y
    {
        type            symmetryPlane;
    }
    max_y
    {
        type            symmetryPlane;
    }
    coolantZone_to_claddingZone
    {
        type            kqRWallFunction;
        value           uniform 0.06;
    }
    procBoundary3to0
    {
        type            processor;
        value           uniform 0.06;
    }
    procBoundary3to2
    {
        type            processor;
        value           uniform 0.06;
    }
    procBoundary3to4
    {
        type            processor;
        value           uniform 0.06;
    }
    procBoundary3to5
    {
        type            processor;
        value           uniform 0.06;
    }
    procBoundary3to7
    {
        type            processor;
        value           uniform 0.06;
    }
    procBoundary3to9
    {
        type            processor;
        value           uniform 0.06;
    }
    procBoundary3to10
    {
        type            processor;
        value           uniform 0.06;
    }
}


