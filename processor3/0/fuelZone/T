FoamFile
{
    version     2.0;
    format      ascii;
    arch        "LSB;label=32;scalar=64";
    class       volScalarField;
    location    "0/fuelZone";
    object      T;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 0 0 1 0 0 0];

internalField   uniform 1200;

boundaryField
{
    inlet
    {
        type            zeroGradient;
    }
    outlet
    {
        type            zeroGradient;
    }
    fuelZone_to_claddingZone
    {
        type            compressible::turbulentTemperatureRadCoupledMixed;
        Tmesh           T;
        kappaMethod     solidThermo;
        value           uniform 1200;
    }
    procBoundary3to4
    {
        type            processor;
        value           uniform 1200;
    }
    procBoundary3to5
    {
        type            processor;
        value           uniform 1200;
    }
    procBoundary3to9
    {
        type            processor;
        value           uniform 1200;
    }
    procBoundary3to11
    {
        type            processor;
        value           uniform 1200;
    }
}


