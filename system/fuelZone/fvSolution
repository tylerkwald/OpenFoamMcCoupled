FoamFile
{
    version     2.0;
    format      ascii;
    arch        "LSB;label=32;scalar=64";
    class       dictionary;
    location    "system/fuelZone";
    object      fvSolution;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

solvers
{
    h
    {
        solver           PCG;
        preconditioner   DIC;
        tolerance        1e-08;
        relTol           0.1;
    }

    hFinal
    {
        $h;
        tolerance        1e-08;
        relTol           0;
    }
}

PIMPLE
{
    nOuterCorrectors    3;
    nNonOrthogonalCorrectors 1;
}


