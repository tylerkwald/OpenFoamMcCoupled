FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "system/coolantZone";
    object      fvOptions;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

limitT
{
    type            limitTemperature;
    active          true;
    selectionMode   all;
    min             400.0;  // Absolute floor: Water cannot drop below 400 K numerically
    max             1200.0; // Absolute ceiling to prevent runaway hotspots
}

