FoamFile
{
    version     2.0;
    format      ascii;
    arch        "LSB;label=32;scalar=64";
    class       dictionary;
    location    "system/coolantZone";
    object      fvSchemes;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

ddtSchemes
{
    default         Euler;
}

gradSchemes
{
    default         Gauss linear;
}
divSchemes
{
    default         none;

    // Density is perfectly fine with bounded upwind
    div(phi,rho)    bounded Gauss upwind; 

    // FIX 1 & 2: Use linearUpwindV (Vector) for U, without the 'bounded' wrapper
    div(phi,U)      Gauss linearUpwindV grad(U);

    // FIX 3: Enthalpy (scalar) uses standard linearUpwind
    div(phi,h)      Gauss linearUpwind grad(h);
    div(phi,K)      Gauss linearUpwind grad(K);


    // FIX 4: Corrected uppercase K to lowercase k. 
    // Strict first-order upwind for turbulence stability.
    turbulence      Gauss upwind;
    div(phi,k)      $turbulence;
    div(phi,epsilon) $turbulence;
    div(phi,R)      $turbulence;

    // Stress tensor divergence operators
    div(R)          Gauss linear;
    div(((rho*nuEff)*dev2(T(grad(U))))) Gauss linear;
}
