FoamFile
{
    version     2.0;
    format      ascii;
    arch        "LSB;label=32;scalar=64";
    class       volScalarField;
    location    "0/coolantZone";
    object      T;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 0 0 1 0 0 0];

internalField   uniform 550;

boundaryField
{
    inlet
    {
        type            fixedValue;
        value           nonuniform List<scalar> 0();
    }
    outlet
    {
        type            zeroGradient;
    }
    min_x
    {
        type            symmetryPlane;
    }
    max_x
    {
        type            symmetryPlane;
    }
    min_y
    {
        type            symmetryPlane;
    }
    max_y
    {
        type            symmetryPlane;
    }
    coolantZone_to_claddingZone
    {
        type            compressible::turbulentTemperatureRadCoupledMixed;
        Tmesh           T;
        kappaMethod     fluidThermo;
        value           uniform 550;
    }
    procBoundary4to1
    {
        type            processor;
        value           uniform 550;
    }
    procBoundary4to2
    {
        type            processor;
        value           uniform 550;
    }
    procBoundary4to3
    {
        type            processor;
        value           uniform 550;
    }
    procBoundary4to5
    {
        type            processor;
        value           uniform 550;
    }
    procBoundary4to7
    {
        type            processor;
        value           uniform 550;
    }
}


