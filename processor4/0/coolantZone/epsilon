FoamFile
{
    version     2.0;
    format      ascii;
    arch        "LSB;label=32;scalar=64";
    class       volScalarField;
    location    "0/coolantZone";
    object      epsilon;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 2 -3 0 0 0 0];

internalField   uniform 0.17;

boundaryField
{
    inlet
    {
        type            fixedValue;
        value           uniform 0.17;
    }
    outlet
    {
        type            inletOutlet;
        inletValue      uniform 0.17;
        value           uniform 0.17;
    }
    min_x
    {
        type            symmetryPlane;
    }
    max_x
    {
        type            symmetryPlane;
    }
    min_y
    {
        type            symmetryPlane;
    }
    max_y
    {
        type            symmetryPlane;
    }
    coolantZone_to_claddingZone
    {
        type            epsilonWallFunction;
        value           uniform 0.17;
    }
    procBoundary4to2
    {
        type            processor;
        value           uniform 0.17;
    }
    procBoundary4to5
    {
        type            processor;
        value           uniform 0.17;
    }
}


