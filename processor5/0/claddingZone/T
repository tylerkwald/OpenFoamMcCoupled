FoamFile
{
    version     2.0;
    format      ascii;
    arch        "LSB;label=32;scalar=64";
    class       volScalarField;
    location    "0/claddingZone";
    object      T;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 0 0 1 0 0 0];

internalField   uniform 600;

boundaryField
{
    inlet
    {
        type            zeroGradient;
    }
    outlet
    {
        type            zeroGradient;
    }
    claddingZone_to_fuelZone
    {
        type            compressible::turbulentTemperatureRadCoupledMixed;
        Tmesh           T;
        kappaMethod     solidThermo;
        value           uniform 600;
    }
    claddingZone_to_coolantZone
    {
        type            compressible::turbulentTemperatureRadCoupledMixed;
        Tmesh           T;
        kappaMethod     solidThermo;
        value           uniform 600;
    }
    procBoundary5to2
    {
        type            processor;
        value           uniform 600;
    }
    procBoundary5to3
    {
        type            processor;
        value           uniform 600;
    }
    procBoundary5to4
    {
        type            processor;
        value           uniform 600;
    }
}


