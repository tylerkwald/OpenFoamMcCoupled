FoamFile
{
    version     2.0;
    format      ascii;
    arch        "LSB;label=32;scalar=64";
    class       volScalarField;
    location    "0/claddingZone";
    object      p;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [1 -1 -2 0 0 0 0];

internalField   uniform 15700000;

boundaryField
{
    inlet
    {
        type            calculated;
        value           uniform 15700000;
    }
    outlet
    {
        type            calculated;
        value           uniform 15700000;
    }
    claddingZone_to_fuelZone
    {
        type            calculated;
        value           uniform 15700000;
    }
    claddingZone_to_coolantZone
    {
        type            calculated;
        value           uniform 15700000;
    }
    procBoundary0to1
    {
        type            processor;
        value           uniform 15700000;
    }
    procBoundary0to4
    {
        type            processor;
        value           uniform 15700000;
    }
}


