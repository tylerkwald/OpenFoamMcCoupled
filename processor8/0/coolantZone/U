FoamFile
{
    version     2.0;
    format      ascii;
    arch        "LSB;label=32;scalar=64";
    class       volVectorField;
    location    "0/coolantZone";
    object      U;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 1 -1 0 0 0 0];

internalField   uniform (0 0 4);

boundaryField
{
    inlet
    {
        type            fixedValue;
        value           nonuniform List<vector> 0();
    }
    outlet
    {
        type            zeroGradient;
    }
    min_x
    {
        type            symmetryPlane;
    }
    max_x
    {
        type            symmetryPlane;
    }
    min_y
    {
        type            symmetryPlane;
    }
    max_y
    {
        type            symmetryPlane;
    }
    coolantZone_to_claddingZone
    {
        type            noSlip;
    }
    procBoundary8to6
    {
        type            processor;
        value           uniform (0 0 4);
    }
    procBoundary8to7
    {
        type            processor;
        value           uniform (0 0 4);
    }
    procBoundary8to10
    {
        type            processor;
        value           uniform (0 0 4);
    }
    procBoundary8to11
    {
        type            processor;
        value           uniform (0 0 4);
    }
}


